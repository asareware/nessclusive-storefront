{{ 'ness-bestsellers.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Bestsellers — live product grid.

  Nothing about a product is authored in the customizer: title, price, photo,
  and sold-out state all come from the catalog (Decision #2). The only settings
  are the heading, which collection feeds the grid, and how many cards to show.
  Card design, columns, and typography are fixed by the design — see the
  Editability policy in PLAN.md.
{%- endcomment -%}

{%- liquid
  comment
    A chosen collection wins. With none set — or one that has been emptied in
    admin — the whole catalog stands in, so the homepage never renders a hole
    because someone unpublished a collection. Placeholder cards appear only on
    a store with no products at all, i.e. in the customizer before setup.
  endcomment
  assign feed = section.settings.collection
  if feed == blank or feed.products_count == 0
    assign feed = collections.all
  endif

  assign heading_id = 'ness-bestsellers-heading-' | append: section.id
  assign view_all_url = feed.url | default: routes.all_products_collection_url
-%}

<section
  class="ness-bestsellers"
  id="bestsellers"
  aria-labelledby="{{ heading_id }}"
>
  <div class="ness-bestsellers__head">
    <h2 class="ness-bestsellers__heading" id="{{ heading_id }}">
      {{- section.settings.heading -}}
    </h2>

    {%- comment -%}
      "View all" has no destination setting on purpose: it follows whichever
      collection feeds the grid, so it can never point somewhere the grid does
      not. The aria-label stops it announcing as a bare "View all".
    {%- endcomment -%}
    <a
      href="{{ view_all_url }}"
      class="ness-bestsellers__view-all"
      aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: feed.title }}"
    >
      {{- 'sections.featured_collection.view_all' | t | default: 'View all' -}}
    </a>
  </div>

  <ul class="ness-bestsellers__grid" role="list">
    {%- for product in feed.products limit: section.settings.products_to_show -%}
      {%- liquid
        assign image_alt = product.featured_media.alt | default: product.title

        assign price = product.price | money_with_currency
        if product.price_varies
          assign price_label = 'products.product.price.from_price_html' | t: price: price
        else
          assign price_label = price
        endif

        comment
          The round button opens the product page rather than adding to the
          cart. Processing Time and Pickup Option are line item properties
          collected on the product page, and a quick-add would skip them —
          PLAN.md is explicit that nothing may bypass that step.
        endcomment
        if product.has_only_default_variant
          assign add_action = 'products.product.view_full_details' | t
        else
          assign add_action = 'products.product.choose_options' | t
        endif
        assign add_label = add_action | append: ': ' | append: product.title
      -%}

      <li class="ness-bestsellers__card">
        {%- comment -%}
          Fixed 390 : 463 frame with object-fit: cover, so a catalog photo of
          any shape crops to the design instead of distorting the row. Widths
          stop at 1040: the card is ~349px in the 1770px shell, which covers 2×
          displays with room to spare.
        {%- endcomment -%}
        <div class="ness-bestsellers__media">
          {%- if product.featured_media != blank -%}
            {{
              product.featured_media
              | image_url: width: 1040
              | image_tag:
                class: 'ness-media',
                alt: image_alt,
                widths: '260, 350, 520, 700, 780, 1040',
                sizes: '(min-width: 1180px) 24vw, (min-width: 750px) 33vw, 92vw',
                loading: 'lazy'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ness-bestsellers__placeholder' }}
          {%- endif -%}

          {%- unless product.available -%}
            <span class="ness-bestsellers__badge">
              {{- 'products.product.sold_out' | t | default: 'Sold out' -}}
            </span>
          {%- endunless -%}
        </div>

        <div class="ness-bestsellers__info">
          <div class="ness-bestsellers__text">
            {%- comment -%}
              A real h3 under the section's h2. The link stretches over the
              whole card, which is how the photo stays clickable — as in the
              prototype — without a second tab stop to the same page.
            {%- endcomment -%}
            <h3 class="ness-bestsellers__title">
              <a href="{{ product.url }}" class="ness-bestsellers__link">
                {{- product.title | escape -}}
              </a>
            </h3>
            <p class="ness-bestsellers__price">
              <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
              {{ price_label }}
            </p>
          </div>

          {%- if product.available -%}
            <a href="{{ product.url }}" class="ness-bestsellers__add" aria-label="{{ add_label | escape }}">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
                <path d="M7 1.5V12.5M1.5 7H12.5"/>
              </svg>
            </a>
          {%- else -%}
            {%- comment -%}
              Sold out: the circle stays for the layout but is inert and hidden
              from screen readers — the badge already carries the state, and
              clicks fall through to the card link underneath.
            {%- endcomment -%}
            <span class="ness-bestsellers__add ness-bestsellers__add--sold-out" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" focusable="false">
                <path d="M7 1.5V12.5M1.5 7H12.5"/>
              </svg>
            </span>
          {%- endif -%}
        </div>
      </li>
    {%- else -%}
      {%- comment -%}
        No products anywhere yet. Show the grid's shape so the section is
        visible in the customizer, but invent no titles or prices — placeholder
        copy would be the one piece of hardcoded product data in the theme.
      {%- endcomment -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <li class="ness-bestsellers__card" aria-hidden="true">
          <div class="ness-bestsellers__media">
            {{ 'product-1' | placeholder_svg_tag: 'ness-bestsellers__placeholder' }}
          </div>
        </li>
      {%- endfor -%}
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Bestsellers",
  "settings": [
    {
      "type": "paragraph",
      "content": "Titles, prices, photos, and sold-out state come straight from your catalog — they are never typed in here. Card design, columns, and typography are fixed by the design."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Bestseller Hairpieces" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "The grid shows this collection's products, in the order the collection is sorted in admin. Leave empty and it falls back to your whole catalog, so the row is never blank."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products shown",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "info": "How many cards appear in total. The number per row is set by the design and adapts to screen width."
    }
  ],
  "default": {
    "settings": {
      "heading": "Our Bestseller Hairpieces",
      "products_to_show": 4
    }
  }
}
{% endschema %}
