{{ 'ness-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ness-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_id = 'ness-hero-heading-' | append: section.id
  assign cine_id = 'ness-hero-cine-' | append: section.id
  comment
    Always three. The crossfade tiles the loop exactly — each clip's fade-out
    is the next one's fade-in — and the stylesheet's delays are cut for this
    count specifically. The count is fixed in code rather than derived from
    how many settings the merchant filled in, so the hero cannot be reduced to
    a single motionless layer by clearing a field.
  endcomment
  assign layer_count = 3
-%}

<section
  class="ness-hero"
  {% if section.settings.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  {%- comment -%}
    Two full-bleed clips on a slow crossfade, each captioned with the service
    it shows.

    Source order per layer is: a video chosen from Shopify Files, then a still
    photograph, then the clip bundled with the theme. The bundled clip is last
    so it is the out-of-the-box state and the first thing either setting
    overrides — and it means the hero ships showing video without anyone
    having to upload anything.

    Files-hosted video is the better of the two paths and the one to prefer:
    Shopify transcodes the upload, serves it as adaptive HLS, and picks a rung
    to suit the visitor's connection. The bundled copies are necessarily small
    — a theme asset is capped at 20MB and is served at one fixed size — so
    they are softer on a large desktop display. See PLAN.md.

    The video elements are decorative; the caption beside them carries the
    meaning, so they are hidden from assistive technology and the captions are
    not.
  {%- endcomment -%}
  <div class="ness-hero__media" data-cine-count="{{ layer_count }}">
    <div class="ness-hero__layer">
      {%- if section.settings.video_1 != blank -%}
        {%- comment -%}
          video_tag builds the element itself and cannot be handed an
          aria-hidden attribute — a hyphenated parameter name is not valid
          Liquid. The wrapper carries it instead, and display:contents keeps
          that wrapper out of the layout entirely, so the video still fills
          the layer exactly as the bundled one does.
        {%- endcomment -%}
        <div class="ness-hero__video-wrap" aria-hidden="true">
          {{
            section.settings.video_1
            | video_tag:
              image_size: '1400x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'ness-hero__video'
          }}
        </div>
      {%- elsif section.settings.image_1 != blank -%}
        {{
          section.settings.image_1
          | image_url: width: 2400
          | image_tag:
            alt: '',
            widths: '750, 1100, 1500, 1900, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        {%- comment -%}
          preload="auto" on the first clip only. It is what is on screen at
          first paint, so it is worth the bandwidth; the second is metadata
          only until the crossfade is nearly due, which keeps the two from
          competing over the connection while the page is still painting.

          poster is a real still pulled from the clip itself, so the frame
          shown while the video buffers matches the first frame of playback
          rather than cutting to it.
        {%- endcomment -%}
        <video
          class="ness-hero__video"
          poster="{{ 'ness-hero-style-poster.jpg' | asset_url }}"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
          tabindex="-1"
        >
          <source src="{{ 'ness-hero-style.mp4' | asset_url }}" type="video/mp4">
        </video>
      {%- endif -%}

      {%- if section.settings.caption_1 != blank -%}
        <div class="ness-hero__caption-slot">
          <p class="ness-hero__caption">{{ section.settings.caption_1 | escape }}</p>
        </div>
      {%- endif -%}
    </div>

    <div class="ness-hero__layer">
      {%- if section.settings.video_2 != blank -%}
        <div class="ness-hero__video-wrap" aria-hidden="true">
          {{
            section.settings.video_2
            | video_tag:
              image_size: '1400x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'ness-hero__video'
          }}
        </div>
      {%- elsif section.settings.image_2 != blank -%}
        {{
          section.settings.image_2
          | image_url: width: 2400
          | image_tag:
            alt: '',
            widths: '750, 1100, 1500, 1900, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'low'
        }}
      {%- else -%}
        <video
          class="ness-hero__video"
          poster="{{ 'ness-hero-wedding-poster.jpg' | asset_url }}"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-hidden="true"
          tabindex="-1"
        >
          <source src="{{ 'ness-hero-wedding.mp4' | asset_url }}" type="video/mp4">
        </video>
      {%- endif -%}

      {%- if section.settings.caption_2 != blank -%}
        <div class="ness-hero__caption-slot">
          <p class="ness-hero__caption">{{ section.settings.caption_2 | escape }}</p>
        </div>
      {%- endif -%}
    </div>

    <div class="ness-hero__layer">
      {%- if section.settings.video_3 != blank -%}
        <div class="ness-hero__video-wrap" aria-hidden="true">
          {{
            section.settings.video_3
            | video_tag:
              image_size: '1400x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              class: 'ness-hero__video'
          }}
        </div>
      {%- elsif section.settings.image_3 != blank -%}
        {{
          section.settings.image_3
          | image_url: width: 2400
          | image_tag:
            alt: '',
            widths: '750, 1100, 1500, 1900, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'low'
        }}
      {%- else -%}
        <video
          class="ness-hero__video"
          poster="{{ 'ness-hero-luxury-poster.jpg' | asset_url }}"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          aria-hidden="true"
          tabindex="-1"
        >
          <source src="{{ 'ness-hero-luxury.mp4' | asset_url }}" type="video/mp4">
        </video>
      {%- endif -%}

      {%- if section.settings.caption_3 != blank -%}
        <div class="ness-hero__caption-slot">
          <p class="ness-hero__caption">{{ section.settings.caption_3 | escape }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="ness-hero__wash" aria-hidden="true"></div>

  {%- comment -%}
    Play/pause for the hero.

    A checkbox rather than a button, because WCAG 2.2.2 wants a pause for
    anything moving beyond five seconds and this loop is infinite: `:checked ~`
    halts the CSS crossfade with no JavaScript at all, so that half of the
    guarantee holds even if scripting is blocked.

    Video is the part CSS cannot stop — only the media API can pause playback
    — so ness-hero.js mirrors this checkbox onto the video elements. With
    JavaScript blocked the clips keep playing while the crossfade holds; the
    control is still honoured, just partially.

    role="switch" keeps the accessible name fixed at "Pause the slideshow"
    with aria-checked carrying state, rather than a changing name plus
    aria-pressed, which announces "Play, pressed" — the inverse of what is
    true.
  {%- endcomment -%}
  {%- if layer_count > 1 -%}
    <input
      type="checkbox"
      id="{{ cine_id }}"
      class="ness-hero__cine-input"
      role="switch"
      data-ness-hero-pause
    >
    <label class="ness-hero__cine" for="{{ cine_id }}">
      <svg class="ness-hero__cine-icon ness-hero__cine-icon--pause" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true" focusable="false">
        <rect x="0" y="0" width="4" height="14" rx="1"/>
        <rect x="8" y="0" width="4" height="14" rx="1"/>
      </svg>
      <svg class="ness-hero__cine-icon ness-hero__cine-icon--play" width="12" height="14" viewBox="0 0 12 14" aria-hidden="true" focusable="false">
        <path d="M0 0.8 C0 0.1 0.8 -0.3 1.4 0.1 L11.4 6.3 C11.9 6.6 11.9 7.4 11.4 7.7 L1.4 13.9 C0.8 14.3 0 13.9 0 13.2 Z"/>
      </svg>
      <span class="ness-hero__cine-label ness-hero__cine-label--pause">Pause</span>
      <span class="ness-hero__cine-label ness-hero__cine-label--play">Play</span>
      <span class="visually-hidden"> the slideshow</span>
    </label>
  {%- endif -%}

  <div class="ness-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="ness-hero__heading" id="{{ heading_id }}">
        {{- section.settings.heading | escape -}}
      </h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="ness-hero__body">{{ section.settings.body | escape }}</p>
    {%- endif -%}

    {%- comment -%}
      Quick links into the page below. data-smooth is picked up by
      ness-motion.js; without it these remain ordinary anchors that jump, so
      the panel works with scripting disabled.
    {%- endcomment -%}
    {%- assign links = section.blocks | where: 'type', 'link' -%}
    {%- if links.size > 0 -%}
      <nav class="ness-hero__links" aria-label="Jump to section">
        {%- for block in links -%}
          <a
            class="ness-hero__link"
            href="#{{ block.settings.target }}"
            data-smooth
            {{ block.shopify_attributes }}
          >
            <span>{{ block.settings.label | escape }}</span>
            <svg width="13" height="9" viewBox="0 0 12.126 8.907" aria-hidden="true" focusable="false">
              <path d="M 12.126 1.241 L 11.144 0 L 6.063 6.416 L 0.982 0 L 0 1.241 L 6.063 8.907 L 12.126 1.241 Z"/>
            </svg>
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Three full-height clips that cross-fade on a slow loop, each labelled with the service it shows. The theme ships with a clip in all three slots, so this works without you uploading anything. Type, colours, and the dark overlay are fixed by the design."
    },
    {
      "type": "header",
      "content": "First clip"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Video",
      "info": "Upload under Content → Files first, then pick it here. This is the better route: Shopify re-encodes the file and serves the right size for each visitor's screen and connection, so it looks sharper than the copy bundled with the theme. Vertical phone footage works, but it is cropped to a wide band on desktop — footage shot landscape fills the screen best."
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Still photograph instead",
      "info": "Optional. Use this to show a photograph in place of the video. If both are set the video wins."
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Caption",
      "default": "Hair Styles",
      "info": "Fades in slowly over this clip. Keep it to two or three words — it names the service the footage shows. Leave empty for no caption."
    },
    {
      "type": "header",
      "content": "Second clip"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "Video",
      "info": "Same guidance as the first clip."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Still photograph instead",
      "info": "Optional. Same guidance as the first clip."
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "Caption",
      "default": "Bridal Styles",
      "info": "Fades in slowly over the second clip."
    },
    {
      "type": "header",
      "content": "Third clip"
    },
    {
      "type": "video",
      "id": "video_3",
      "label": "Video",
      "info": "Same guidance as the first clip."
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Still photograph instead",
      "info": "Optional. Same guidance as the first clip."
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "Caption",
      "default": "Luxury Styles",
      "info": "Fades in slowly over the third clip."
    },
    {
      "type": "header",
      "content": "Wording"
    },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Nessclusive Hair Company", "info": "Around 25 characters is what the design was drawn for — the headline is capped at 15ch and wraps beyond that." },
    { "type": "textarea", "id": "body", "label": "Sub-heading", "default": "Let your Wig do the talking with Nessclusive" }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Wording", "default": "Our Service" },
        {
          "type": "select",
          "id": "target",
          "label": "Scrolls to",
          "default": "services",
          "info": "Sections further down this page. The page scrolls smoothly to whichever you pick.",
          "options": [
            { "value": "services", "label": "Services" },
            { "value": "book", "label": "Book a session" },
            { "value": "about", "label": "About us" },
            { "value": "luxury", "label": "Luxury Looks" },
            { "value": "collections", "label": "Explore Collection" },
            { "value": "faq", "label": "FAQ" },
            { "value": "contact", "label": "Contact" }
          ]
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "label": "Our Service", "target": "services" } },
      { "type": "link", "settings": { "label": "Luxury Looks", "target": "luxury" } },
      { "type": "link", "settings": { "label": "Booking", "target": "book" } }
    ]
  }
}
{% endschema %}
