{{ 'ness-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_id = 'ness-hero-heading-' | append: section.id
-%}

<section
  class="ness-hero"
  {% if section.settings.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  {%- comment -%}
    The photograph is decorative — the headline beside it carries the meaning —
    so alt is empty and the layer is hidden from assistive tech. Eager, and
    with fetchpriority, because it is the largest contentful paint on the page.
  {%- endcomment -%}
  <div class="ness-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          alt: '',
          widths: '750, 1100, 1500, 1900, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- else -%}
      <img
        src="{{ 'ness-hero-bg.jpg' | asset_url }}"
        alt=""
        width="1000"
        height="667"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="ness-hero__wash" aria-hidden="true"></div>

  <div class="ness-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="ness-hero__heading" id="{{ heading_id }}">
        {{- section.settings.heading | escape -}}
      </h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="ness-hero__body">{{ section.settings.body | escape }}</p>
    {%- endif -%}

    {%- comment -%}
      Quick links into the page below. data-smooth is picked up by
      ness-motion.js; without it these remain ordinary anchors that jump, so
      the panel works with scripting disabled.
    {%- endcomment -%}
    {%- assign links = section.blocks | where: 'type', 'link' -%}
    {%- if links.size > 0 -%}
      <nav class="ness-hero__links" aria-label="Jump to section">
        {%- for block in links -%}
          <a
            class="ness-hero__link"
            href="#{{ block.settings.target }}"
            data-smooth
            {{ block.shopify_attributes }}
          >
            <span>{{ block.settings.label | escape }}</span>
            <svg width="13" height="9" viewBox="0 0 12.126 8.907" fill="#621E69" aria-hidden="true" focusable="false">
              <path d="M 12.126 1.241 L 11.144 0 L 6.063 6.416 L 0.982 0 L 0 1.241 L 6.063 8.907 L 12.126 1.241 Z"/>
            </svg>
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-height opening image with the headline over it. Type, colours, and the gradient wash are fixed by the design."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background photograph",
      "info": "Fills the screen and is cropped to fit, so nothing stretches. Use a wide landscape image of at least 2400px. Keep the subject right of centre — the left side sits under the wash that the headline reads against."
    },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Nessclusive, Be Bold, Be Exclusive", "info": "Around 30 characters is what the design was drawn for." },
    { "type": "textarea", "id": "body", "label": "Sub-heading", "default": "Let your Wig do the talking with Nessclusive" }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Wording", "default": "Our Services" },
        {
          "type": "select",
          "id": "target",
          "label": "Scrolls to",
          "default": "services",
          "info": "Sections further down this page. The page scrolls smoothly to whichever you pick.",
          "options": [
            { "value": "services", "label": "Services" },
            { "value": "book", "label": "Book a session" },
            { "value": "about", "label": "About us" },
            { "value": "collections", "label": "Explore Collection" },
            { "value": "bestsellers", "label": "Bestsellers" },
            { "value": "faq", "label": "FAQ" },
            { "value": "contact", "label": "Contact" }
          ]
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "label": "Our Services", "target": "services" } },
      { "type": "link", "settings": { "label": "Book a Session", "target": "book" } },
      { "type": "link", "settings": { "label": "A Little About Us", "target": "about" } }
    ]
  }
}
{% endschema %}
