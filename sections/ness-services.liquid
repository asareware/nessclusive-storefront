{{ 'ness-services.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign panels = section.blocks | where: 'type', 'service'
  assign heading_id = 'ness-services-heading-' | append: section.id
-%}

{%- comment -%}
  id="services" is a fixed anchor, not a setting — the hero's quick links and
  the header both scroll here by that name, and letting it be edited would
  break those silently. scroll-margin-top clears the floating header.
{%- endcomment -%}
<section
  class="ness-services"
  id="services"
  {% if section.settings.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.intro != blank -%}
    <div class="ness-services__intro">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="ness-services__intro-head" data-reveal="0">
          {%- if section.settings.eyebrow != blank -%}
            <p class="ness-services__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="ness-services__heading" id="{{ heading_id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- endif -%}
          {%- comment -%}
            Purely decorative rule under the heading block. It carries no
            meaning, so it is hidden from assistive tech rather than announced
            as an empty element.
          {%- endcomment -%}
          <span class="ness-services__rule" aria-hidden="true"></span>
        </div>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="ness-services__lede" data-reveal="80">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if panels.size > 0 -%}
    <div class="ness-services__stack">
      {%- for block in panels -%}
        <div
          class="ness-services__panel ness-services__panel--{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          <div class="ness-services__inner">
            <div class="ness-services__media" data-reveal="0">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    alt: block.settings.image.alt,
                    widths: '450, 700, 900, 1200',
                    sizes: '(min-width: 1180px) 45vw, 92vw',
                    loading: 'lazy'
                }}
              {%- elsif forloop.index <= 3 -%}
                {%- comment -%}
                  Bundled prototype photography for the three panels the design
                  specifies; a fourth or fifth panel gets the grey placeholder,
                  which is the honest signal that it needs a picture.
                {%- endcomment -%}
                {%- comment -%}
                  Intrinsic dimensions are stated per panel rather than shared,
                  because the three bundled photographs are not one shape: the
                  first two are landscape studio frames and the third is a
                  vertical phone shot. A single width/height pair would give
                  the browser the wrong aspect for at least one of them before
                  the stylesheet lands.
                {%- endcomment -%}
                {%- liquid
                  case forloop.index
                    when 1
                      assign fallback = 'ness-services-1.jpg'
                      assign fallback_w = 1600
                      assign fallback_h = 900
                    when 2
                      assign fallback = 'ness-services-2.jpg'
                      assign fallback_w = 1600
                      assign fallback_h = 900
                    else
                      assign fallback = 'ness-services-3.jpg'
                      assign fallback_w = 1167
                      assign fallback_h = 2091
                  endcase
                -%}
                <img
                  src="{{ fallback | asset_url }}"
                  alt=""
                  width="{{ fallback_w }}"
                  height="{{ fallback_h }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="ness-services__copy">
              <span class="ness-services__number" data-reveal="60" aria-hidden="true">
                {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
              </span>
              {%- if block.settings.title != blank -%}
                <h3 class="ness-services__title" data-reveal="120">
                  {{- block.settings.title | escape -}}
                </h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="ness-services__body" data-reveal="180">
                  {{- block.settings.body | escape -}}
                </p>
              {%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                {%- capture cta_url -%}
                  {%- render 'ness-nav-url', destination: block.settings.cta_destination -%}
                {%- endcapture -%}
                <a class="ness-services__cta" href="{{ cta_url }}" data-reveal="240">
                  {{- block.settings.cta_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{%- comment -%}
  The intro default deliberately drops the prototype's "Three ways": panels are
  editable up to five, so a merchant who adds a fourth would be left with a
  sentence contradicting the page below it. No default may name a count.

  Its help text no longer offers "one or two lines" either. The field is a
  textarea for typing room, but the lede renders as a single escaped paragraph,
  so any line break the merchant types is silently dropped. Newlines are not
  converted deliberately — a hard break in a lede the design lets wrap fluidly
  is exactly the kind of layout decision the editability policy keeps out of
  the customizer.
{%- endcomment -%}
{% schema %}
{
  "name": "Services",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-height panels that stack over one another as the page scrolls. The stacking, colours, and type are fixed by the design — you can edit each panel's picture and wording, and add or remove panels up to five."
    },
    { "type": "text", "id": "eyebrow", "label": "Small heading above", "default": "What we do" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Services" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "How we look after your hair, in studio and in your chair.",
      "info": "A single sentence under the heading, about 60 characters. Leave empty to hide it."
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "service",
      "name": "Service panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture",
          "info": "Cropped to fit, so any shape works. Landscape of at least 1200px wide looks best."
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Wig Installation" },
        {
          "type": "textarea",
          "id": "body",
          "label": "Description",
          "default": "Your unit fitted, melted and styled in studio. Custom lace tint, a natural hairline and a cut shaped to your face.",
          "info": "Around 140 characters is what the design was drawn for."
        },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Book this service", "info": "Leave empty to hide the button." },
        {
          "type": "select",
          "id": "cta_destination",
          "label": "Button goes to",
          "default": "booking",
          "options": [
            { "value": "all_products", "label": "All products" },
            { "value": "ready_to_ship", "label": "Ready to Ship" },
            { "value": "pre_order", "label": "Pre-Order" },
            { "value": "accessories", "label": "Accessories" },
            { "value": "booking", "label": "Booking page" },
            { "value": "contact", "label": "Contact page" }
          ]
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "service",
        "settings": {
          "title": "Wig Installation",
          "body": "Your unit fitted, melted and styled in studio. Custom lace tint, a natural hairline and a cut shaped to your face.",
          "cta_label": "Book this service",
          "cta_destination": "booking"
        }
      },
      {
        "type": "service",
        "settings": {
          "title": "Sew-in Service",
          "body": "Braided down, sewn in and blended. A protective install that lays flat, moves freely and holds its shape for weeks.",
          "cta_label": "Book this service",
          "cta_destination": "booking"
        }
      },
      {
        "type": "service",
        "settings": {
          "title": "Natural Hair Care",
          "body": "Wash, deep condition, trim and silk press. Treatments that keep your own hair strong underneath every style.",
          "cta_label": "Book this service",
          "cta_destination": "booking"
        }
      }
    ]
  }
}
{% endschema %}
